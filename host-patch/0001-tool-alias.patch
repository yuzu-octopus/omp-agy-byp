{
  "id": "0001-tool-alias",
  "hostVersion": "18.22.2",
  "target": "pi-ai/src/providers/antigravity-cli/host.ts",
  "edits": [
    {
      "id": "seam-declarations",
      "anchor": [
        "/** Project a tool onto MCP `tools/list`; the official CLI owns any provider-specific schema conversion. */",
        "function toMcpTool(tool: Tool): McpToolDefinition {"
      ],
      "replacement": [
        "/** Tool-alias seam installed by omp-agy-byp. Inert until the extension registers a provider. */",
        "type AgBypAliasProvider = {",
        "\tresolveOutbound?: (tool: Tool) => McpToolDefinition | undefined;",
        "\tresolveInbound?: (name: string, args: unknown) => { toolName: string; args: unknown } | undefined;",
        "\tresolveResult?: (toolName: string, result: McpToolOutput) => McpToolOutput | undefined;",
        "};",
        "const agBypProviderSlot = \"__ompAgBypToolAliasProvider\";",
        "const agBypGlobal = globalThis as Record<string, unknown>;",
        "const agBypHookName = (suffix: string): string => `__ompAgByp${suffix}`;",
        "const agBypCanonicalTools = new Map<string, McpToolDefinition>();",
        "agBypGlobal[agBypHookName(\"CanonicalTools\")] = agBypCanonicalTools;",
        "function agBypProvider(): AgBypAliasProvider | undefined {",
        "\treturn agBypGlobal[agBypProviderSlot] as AgBypAliasProvider | undefined;",
        "}",
        "agBypGlobal.__ompAgBypSetToolAliasProvider = (provider: AgBypAliasProvider): void => {",
        "\tagBypGlobal[agBypProviderSlot] = provider;",
        "\tagBypGlobal[agBypHookName(\"ProjectTool\")] = (tool: Tool) => provider.resolveOutbound?.(tool);",
        "\tagBypGlobal[agBypHookName(\"ReverseToolCall\")] = (name: string, args: unknown) => provider.resolveInbound?.(name, args);",
        "\tagBypGlobal[agBypHookName(\"ProjectResult\")] = (toolName: string, result: McpToolOutput) =>",
        "\t\tprovider.resolveResult?.(toolName, result);",
        "};",
        "",
        "/** Project a tool onto MCP `tools/list`; the official CLI owns any provider-specific schema conversion. */",
        "function toMcpTool(tool: Tool): McpToolDefinition {"
      ]
    },
    {
      "id": "outbound-projection",
      "anchor": ["\treturn { name: tool.name, description: tool.description, inputSchema: schema };"],
      "replacement": [
        "\tconst agBypCanonical: McpToolDefinition = { name: tool.name, description: tool.description, inputSchema: schema };",
        "\tconst agBypProjected = (globalThis as unknown as Record<string, ((tool: Tool) => McpToolDefinition | undefined) | undefined>).__ompAgBypProjectTool?.(tool);",
        "\tif (agBypProjected) (globalThis as unknown as Record<string, Map<string, McpToolDefinition> | undefined>).__ompAgBypCanonicalTools?.set(tool.name, agBypCanonical);",
        "\treturn agBypProjected ?? agBypCanonical;"
      ]
    },
    {
      "id": "inbound-reverse-map",
      "anchor": ["\t\tconst tool = agy.tools.get(name);"],
      "replacement": [
        "\t\tconst mappedCall = (globalThis as unknown as Record<string, ((name: string, args: unknown) => { toolName: string; args: unknown } | undefined) | undefined>).__ompAgBypReverseToolCall?.(name, args);",
        "\t\tconst canonicalName = mappedCall?.toolName ?? name;",
        "\t\tconst canonicalArgs = mappedCall?.args ?? args;",
        "\t\tconst canonicalTool = (globalThis as unknown as Record<string, Map<string, McpToolDefinition> | undefined>).__ompAgBypCanonicalTools?.get(canonicalName);",
        "\t\tconst tool = canonicalTool ?? agy.tools.get(name);"
      ]
    },
    {
      "id": "inbound-canonical-validation",
      "anchor": ["\t\tconst validation = validateJsonSchemaValue(tool.inputSchema, args);"],
      "replacement": ["\t\tconst validation = validateJsonSchemaValue(tool.inputSchema, canonicalArgs);"]
    },
    {
      "id": "inbound-canonical-args-narrowing",
      "anchor": ["\t\tif (!isRecord(args)) return errorOutput(describeToolArguments(tool, args));"],
      "replacement": [
        "\t\tif (!isRecord(args)) return errorOutput(describeToolArguments(tool, args));",
        "\t\tif (!isRecord(canonicalArgs)) return errorOutput(describeToolArguments(tool, canonicalArgs));"
      ]
    },
    {
      "id": "pending-canonical-field",
      "anchor": ["interface PendingCall {", "\tid: string;"],
      "replacement": ["interface PendingCall {", "\tid: string;", "\tcanonicalName?: string;"]
    },
    {
      "id": "inbound-canonical-call-record",
      "anchor": ["\t\tstep.writer.toolCall({ type: \"toolCall\", id, name, arguments: args });"],
      "replacement": ["\t\tstep.writer.toolCall({ type: \"toolCall\", id, name: canonicalName, arguments: canonicalArgs });"]
    },
    {
      "id": "inbound-pending-canonical",
      "anchor": ["\t\t\tid,", "\t\t\tstate: \"parked\","],
      "replacement": ["\t\t\tid,", "\t\t\tcanonicalName,", "\t\t\tstate: \"parked\","]
    },
    {
      "id": "result-projection",
      "anchor": [
        "function toMcpOutput(result: ToolResultMessage): McpToolOutput {",
        "\treturn {",
        "\t\tcontent: result.content.map(part =>",
        "\t\t\tpart.type === \"text\"",
        "\t\t\t\t? { type: \"text\", text: part.text }",
        "\t\t\t\t: { type: \"image\", data: part.data, mimeType: part.mimeType },",
        "\t\t),",
        "\t\tisError: result.isError,",
        "\t};",
        "}"
      ],
      "replacement": [
        "function toMcpOutput(result: ToolResultMessage, canonicalName?: string): McpToolOutput {",
        "\tconst output: McpToolOutput = {",
        "\t\tcontent: result.content.map(part =>",
        "\t\t\tpart.type === \"text\"",
        "\t\t\t\t? { type: \"text\", text: part.text }",
        "\t\t\t\t: { type: \"image\", data: part.data, mimeType: part.mimeType },",
        "\t\t),",
        "\t\tisError: result.isError,",
        "\t};",
        "\treturn (globalThis as unknown as Record<string, ((toolName: string, result: McpToolOutput) => McpToolOutput | undefined) | undefined>).__ompAgBypProjectResult?.(canonicalName ?? result.toolName, output) ?? output;",
        "}"
      ]
    },
    {

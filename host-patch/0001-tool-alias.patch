      "replacement": [
        "/** Tool-alias seam installed by omp-agy-byp. Inert until the extension registers a provider. */",
        "type AgBypAliasProvider = {",
        "\tresolveOutbound?: (tool: Tool) => McpToolDefinition | undefined;",
        "\tresolveInbound?: (name: string, args: unknown) => { name: string; args: unknown } | undefined;",
        "\tresolveResult?: (result: McpToolOutput) => McpToolOutput | undefined;",
        "};",
        "const agBypProviderSlot = \"__ompAgBypToolAliasProvider\";",
        "function agBypProvider(): AgBypAliasProvider | undefined {",
        "\treturn (globalThis as Record<string, AgBypAliasProvider | undefined>)[agBypProviderSlot];",
        "}",
        "export function __ompAgBypSetToolAliasProvider(provider: AgBypAliasProvider): void {",
        "\t(globalThis as Record<string, AgBypAliasProvider | undefined>)[agBypProviderSlot] = provider;",
        "}",
        "export function __ompAgBypReverseToolCall(name: string, args: unknown): { name: string; args: unknown } {",
        "\treturn agBypProvider()?.resolveInbound?.(name, args) ?? { name, args };",
        "}",
        "export function __ompAgBypProjectResult(result: McpToolOutput): McpToolOutput {",
        "\treturn agBypProvider()?.resolveResult?.(result) ?? result;",
        "}",
        "",
        "/** Project a tool onto MCP `tools/list`; the official CLI owns any provider-specific schema conversion. */",
        "function toMcpTool(tool: Tool): McpToolDefinition {"
